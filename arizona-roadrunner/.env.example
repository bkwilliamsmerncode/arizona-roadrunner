# Public EmailJS browser configuration. Configure the recipient in the EmailJS template.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Future hosted checkout service, not Square's API directly.
# Must validate product IDs/prices, create a Square payment link, and return {"checkoutUrl":"https://square.link/..."}.
# Leave empty while Square is not connected.
VITE_CHECKOUT_ENDPOINT=

